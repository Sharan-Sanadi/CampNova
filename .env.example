# ──────────────────────────────────────────────────────────────
# CampusOS API — environment variables reference
# Copy this file to .env (never commit .env).
# All variables used by apps/api/src/config/env.ts are listed here.
# Variables marked REQUIRED must be set; others have safe defaults.
# ──────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
NODE_ENV=production          # development | test | production
HOST=0.0.0.0
PORT=4000

# ── Database — REQUIRED ───────────────────────────────────────
# MongoDB Atlas free-tier (M0) connection string.
# Must include the database name.  replicaSet is needed for transactions.
# Render: add as an env var; never put credentials in git.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusos?retryWrites=true&w=majority

# ── Cache — REQUIRED for queues / pub-sub / rate-limit ───────
# Render Redis (internal): redis://red-<id>:6379
# Upstash (TLS required outside Render internal network): rediss://<user>:<pass>@<host>:6380
REDIS_URL=redis://localhost:6379

# ── Clerk Auth — REQUIRED in production ───────────────────────
# https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_JWT_KEY=                    # optional: RS256 PEM key (enables offline JWT verification)
CLERK_SIGN_IN_URL=/login
CLERK_SIGN_UP_URL=/login

# ── Session / Cookie ──────────────────────────────────────────
COOKIE_SECRET=change-me-to-a-random-32-char-string

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash).
CORS_ORIGINS=https://campnova.onrender.com,https://your-frontend.com

# ── Campus defaults ───────────────────────────────────────────
CAMPUS_TIMEZONE=Asia/Kolkata
DEFAULT_CAMPUS_ID=demo-campus
DEFAULT_CAMPUS_NAME=Demo Campus
SEED_ADMIN_CLERK_USER_ID=      # Clerk user_id to promote to CAMPUS_ADMIN on first seed

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info                 # trace | debug | info | warn | error | fatal

# ── Search (Meilisearch) ──────────────────────────────────────
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=campusos-dev-meili-key

# ── AI / Copilot ──────────────────────────────────────────────
COPILOT_PROVIDER=ollama        # ollama | anthropic | groq
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
ANTHROPIC_API_KEY=             # required when COPILOT_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Data / Import ─────────────────────────────────────────────
DATA_MODE=production           # production | demo
SEED_DEMO_DATA=false
ENABLE_XLSX_IMPORT=false
IMPORT_BATCH_SIZE=500
DATASET_RETENTION_DAYS=30

# ── File upload ───────────────────────────────────────────────
UPLOAD_STORAGE=local           # local | s3
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=20

# ── Misc ──────────────────────────────────────────────────────
BCRYPT_COMPAT=false

# ── Frontend (Vite / TanStack Start) — NOT read by the API ───
# These are build-time variables injected by Vite.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
VITE_API_URL=https://campnova.onrender.com/api/v1
VITE_FORMSPREE_FORM_ID=
